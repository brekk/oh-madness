import type { Card, Suit } from "gambit"
import type { Controller } from "utter/Interpreter"

import type { GamePayload, GameStateContext, OhHell } from "@/Game"
import type { PlayedCard, Player } from "@/Player"

import Dict from "Dictionary"
import IO from "IO"
import List from "List"
import { Just, Nothing } from "Maybe"
import Maybe from "Maybe"
import Random from "Random"
import String from "String"
import Terminal from "Terminal"

import {
  Ace,
  Card,
  Clubs,
  DECK,
  Diamonds,
  Hearts,
  Jack,
  Joker,
  King,
  NoFace,
  Queen,
  Spades,
  Wildcard,
} from "gambit"
import Deck from "gambit/Deck"
import { Action } from "utter/Action"
import { Guard } from "utter/Guard"
import Interpreter from "utter/Interpreter"
import Machine from "utter/Machine"
import Reducer from "utter/Reducer"
import State from "utter/State"
import Transition from "utter/Transition"

import { EVENTS, STATES } from "@/Constants"
import GAMEPLAY from "@/Game"
import Log from "@/Log"
import Oh from "@/OhHell"
import { Bot, Player } from "@/Player"
import { createInitialContext, gameMachine } from "@/StateMachine"



main = () => {
  random = Random.generateFromString("my-cool-game")

  IO.pTrace("COMPLETE?", Machine.findIncomplete(gameMachine))
  // IO.pTrace("GAME", gameMachine)
  statement = (a, b) => pipe(
    Interpreter.state,
    map(State.name),
    Log.env.mainState(a ++ " change!"),
  )(b)
  service = Interpreter.create(createInitialContext(random), gameMachine)
  statement("1", service)
  Log
    .env
    .mainEventPost(
      "PLAYERS!",
      pipe(
        Interpreter.context,
        map((v) => v.players),
      )(service),
    )
  brekk = Player("brekk", [])
  service2 = GAMEPLAY.setPlayers(
    [brekk, Bot(Player("arnaud", [])), Bot(Player("robot", []))],
    service,
  )
  statement("2", service2)
  Log
    .env
    .mainEventPost(
      "PLAYERS AFTER UPDATE!",
      pipe(
        Interpreter.context,
        map(.players),
      )(service2),
    )
  service3 = GAMEPLAY.setDealer(service2)
  statement("3", service3)
  Log
    .env
    .mainEventPost(
      "DEALER SET?",
      pipe(
        Interpreter.context,
        chain(.dealer),
      )(service3),
    )
  service4 = GAMEPLAY.setTrump(service3)
  statement("4", service4)
  Log
    .env
    .mainEventPost(
      "TRUMP CARD SET",
      pipe(
        Interpreter.context,
        map(.trump),
      )(service4),
    )
  service5 = GAMEPLAY.dealCards(service4)
  statement("5", service5)
  service6 = GAMEPLAY.takeBets(Just({{ brekk: 4 }}))
  // Log.env.mainEventPost("CARDS DEALT", service5)
}
