*/
HELLVETICA = `"Helvetica Neue",Helvetica,Arial,sans-serif`
graphvizConfig = {
  ...Graph.VANILLA,
  // some junk
  // elides over existing nodes
  nodeMap: (n) => n == "gameStart" || n == "gameOver" ? [VNode.Shape(VNode.ShapeDoublecircle)] : [],
  attrStyle: [
    VGraph.Fontname(HELLVETICA),
    VGraph.Layout(VGraph.LayoutSFDP),
    VGraph.Nodesep(1.9),
    VGraph.Sep(3.8),
    VGraph.Dimen(2),
    VGraph.Overlap("scale"),
  ],
  nodes: [VNode.GlobalNode([VNode.Fontname(HELLVETICA)])],
  edges: [VEdge.GlobalEdge([VEdge.Fontname(HELLVETICA)])],
}
main = () => {
  random = Random.generateFromString("my-cool-game")
  IO.put(
    pipe(
      Graph.toDotWithConfig(graphvizConfig),
    )(gameMachine),
  )

  service = Interpreter.create(createInitialContext(random), gameMachine)
  hidden = permaloop(service)
  brekk = Game.Player("brekk", [])
  // set the players
  hidden.send(
    GAMEPLAY.setPlayers([
      brekk,
      Player.createBot(Player("arnaud", [])),
      Player.createBot(Player("robot", [])),
    ]),
  )
  // set the dealer
  hidden.send(GAMEPLAY.setDealer)
  // deal the trump card
  hidden.send(GAMEPLAY.setTrump)
  // deal the rest of the cards to the players (up to a known limit)
  hidden.send(GAMEPLAY.dealCards)
  hidden.send(GAMEPLAY.readyToBet)
  // take bets, we need only the bet from the non-player (non-bot wrapped) characters
  hidden.send(GAMEPLAY.takeBet(brekk, 5))
}
