   node [shape="doublecircle", fontname = "'Helvetica Neue',Helvetica,Arial,sans-serif"]
   gameOver
   gameStart
   node [shape="rectangle"]
   nothing [width=0.01 height=0.01 shape=point fixedsize=true label=""]
   betting
   playing
   preparingRound
   ready
   scoring
   betting -> betting [label = "bet", style="dashed"];
   betting -> playing [label = "betsTaken"];
   gameStart -> ready [label = "playersSet"];
   playing -> scoring [label = "roundComplete"];
   playing -> scoring [label = "trickComplete"];
   nothing -> playing [style=invis];
   nothing -> scoring [style=invis];
   preparingRound -> preparingRound [label = "dealing", style="dashed"];
   preparingRound -> betting [label = "readyForBetting"];
   preparingRound -> preparingRound [label = "trumpCardSet", style="dashed"];
   ready -> preparingRound [label = "dealerSet"];
   scoring -> gameOver [label = "endGame"];
   scoring -> preparingRound [label = "roundRecorded"];
   scoring -> playing [label = "trickRecorded"];
