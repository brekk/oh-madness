import IO from "IO"
import Random from "Random"

import Interpreter from "utter/Interpreter"
import Machine from "utter/Machine"
import State from "utter/State"

import GAMEPLAY from "@/Game"
import Loop from "@/GameLoop"
import { permaloop } from "@/GameLoop"
import Log from "@/Log"
import { Bot, Player } from "@/Player"
import { createInitialContext, gameMachine } from "@/StateMachine"



main = () => {
  random = Random.generateFromString("my-cool-game")


  service = Interpreter.create(createInitialContext(random), gameMachine)
  hidden = permaloop(service)

  brekk = Player("brekk", [])
  hidden.send(GAMEPLAY.setPlayers([brekk, Bot(Player("arnaud", [])), Bot(Player("robot", []))]))

  hidden.send(GAMEPLAY.setDealer)
  hidden.send(GAMEPLAY.setTrump)
  hidden.send(GAMEPLAY.dealCards)
  // statement("5", service5)
  // service6 = GAMEPLAY.takeBets(Just(Dict.fromList([#[brekk, 5]])), service5)
  // statement("6", service6)
  // Log.env.mainEventPost("CARDS DEALT", service5)
}
