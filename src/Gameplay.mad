import type { Maybe } from "Maybe"

import type { GameApi, Player } from "@/Game"

import Interpreter from "utter/Interpreter"

import { EVENTS } from "@/Constants"
import { GameDealCards, GameSetDealer, GameSetPlayers, GameSetTrump, GameTakeBet } from "@/Game"
import Log from "@/Log"



setPlayers :: List Player -> GameApi
export setPlayers = (players, sv) => pipe(
  GameSetPlayers,
  Interpreter.send(EVENTS.playersSet, $, sv),
)(players)
setDealer :: GameApi
export setDealer = Interpreter.send(EVENTS.dealerSet, GameSetDealer)
setTrump :: GameApi
export setTrump = Interpreter.send(EVENTS.trumpCardSet, GameSetTrump)
dealCards :: GameApi
export dealCards = Interpreter.send(EVENTS.deal, GameDealCards)
takeBet :: Player -> Integer -> GameApi
export takeBet = (pl, i, sv) => Interpreter.send(EVENTS.bet, GameTakeBet(pl, i), sv)
