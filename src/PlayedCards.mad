import type { Maybe } from "Maybe"

import type { Card } from "gambit"

import type { Player } from "@/Player"

import { Just, Nothing } from "Maybe"

import _Player from "@/Player"



// Keep track of who played what card
export type PlayedCard = PlayedCard(String, Card)
playCard :: Card -> Player -> Maybe PlayedCard
export playCard = (crd, ply) => _Player.hasCard(crd, ply)
  ? Just(PlayedCard(_Player.name(ply), crd))
  : Nothing
cardPlayedBy :: String -> PlayedCard -> Boolean
export cardPlayedBy = (playerName, pCard) => where(pCard) {
  PlayedCard(by, _) =>
    by == playerName
}
card :: PlayedCard -> Card
export card = where {
  PlayedCard(_, c) =>
    c
}
player :: PlayedCard -> String
export player = where {
  PlayedCard(n, _) =>
    n
}
