import type { Maybe } from "Maybe"
import type { Random } from "Random"

import type { Machine } from "utter/Machine"

import type { GamePayload, GameStateContext, OhHell, Player } from "@/Game"

import Dict from "Dictionary"
import { Just, Nothing } from "Maybe"

import { Card, DECK, Joker, Wildcard } from "gambit"
import { Action } from "utter/Action"
import Machine from "utter/Machine"
import State from "utter/State"
import Transition from "utter/Transition"

import { EVENTS, STATES } from "@/Constants"
import Log from "@/Log"
import GUARDS from "@/StateMachine/Guards"
import REDUCERS from "@/StateMachine/Reducers"



announceWith = (k) => Action(
  (e, mPay, mCtx) => {
    Log.env.main((k ?? "") ++ "event: (" ++ e ++ ")", mPay)
  },
)
announce = announceWith(Nothing)
ACTIONS = [announce]
createInitialContext :: Random -> Maybe GameStateContext
export createInitialContext = (random) => Just({
  bets: Dict.empty,
  cardsPerPlayer: -1,
  cardsPerRound: [],
  dealer: Nothing,
  deck: DECK,
  playedCards: [],
  players: [],
  round: -1,
  trick: 0,
  scores: Dict.empty,
  trump: Card(Joker, Wildcard),
  random,
})
gameMachine :: Machine GamePayload GameStateContext
export gameMachine = Machine.create(
  "oh-hell",
  [
    State.create(
      STATES.gameStart,
      [
        Transition.createComplex(
          EVENTS.playersSet,
          STATES.ready,
          ACTIONS,
          [GUARDS.noPlayers],
          [REDUCERS.setPlayers],
        ),
      ],
    ),
    State.create(
      STATES.ready,
      [
        Transition.createComplex(
          EVENTS.dealerSet,
          STATES.preparingRound,
          ACTIONS,
          [GUARDS.hasNoDealer],
          [REDUCERS.setDealer],
        ),
      ],
    ),
    State.create(
      STATES.preparingRound,
      [
        Transition.createComplex(
          EVENTS.trumpCardSet,
          STATES.preparingRound,
          // I believe we can make the actions here be called as a part 
          // of this process
          ACTIONS,
          [GUARDS.hasNoTrumpCard],
          [REDUCERS.setTrump],
        ),
        Transition.createComplex(
          EVENTS.deal,
          STATES.preparingRound,
          ACTIONS,
          [GUARDS.noCardsDealt],
          [REDUCERS.dealCards],
        ),
        Transition.createComplex(
          EVENTS.readyForBetting,
          STATES.betting,
          ACTIONS,
          [GUARDS.betsIncomplete],
          [REDUCERS.takeBet],
        ),
      ],
    ),
    State.create(
      STATES.betting,
      [
        Transition.createComplex(
          EVENTS.bet,
          STATES.betting,
          ACTIONS,
          [GUARDS.betsIncomplete],
          [REDUCERS.takeBet],
        ),
        // transition away
        Transition.createComplex(
          EVENTS.betsTaken,
          STATES.playing,
          ACTIONS,
          [GUARDS.allBetsTaken],
          [],
        ),
      ],
    ),
    State.create(
      STATES.playing,
      [
        Transition.createComplex(
          EVENTS.trickComplete,
          STATES.scoring,
          ACTIONS,
          [GUARDS.roundUnderTotalRound],
          [REDUCERS.recordTrick],
        ),
        Transition.createComplex(
          EVENTS.roundComplete,
          STATES.scoring,
          ACTIONS,
          [GUARDS.allRoundsComplete],
          [REDUCERS.recordRound],
        ),
      ],
    ),
    State.create(
      STATES.scoring,
      [
        Transition.createComplex(
          EVENTS.trickRecorded,
          STATES.playing,
          ACTIONS,
          [GUARDS.roundIncomplete],
          [REDUCERS.updateRound],
        ),
        Transition.createComplex(
          EVENTS.roundRecorded,
          STATES.preparingRound,
          ACTIONS,
          [GUARDS.roundComplete],
          [REDUCERS.recordRound],
        ),
        Transition.createComplex(
          EVENTS.endGame,
          STATES.gameOver,
          ACTIONS,
          [GUARDS.allRoundsComplete],
          [REDUCERS.finalScores],
        ),
      ],
    ),
    State.createFinal(STATES.gameOver),
  ],
)
