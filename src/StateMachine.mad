import type { Maybe } from "Maybe"
import type { Random } from "Random"

import type { Machine } from "utter/Machine"

import type { GamePayload, GameStateContext, OhHell, Player } from "@/Game"

import Dict from "Dictionary"
import { Just, Nothing } from "Maybe"

import { Card, DECK, Joker, Wildcard } from "gambit"
import { Action } from "utter/Action"
import Machine from "utter/Machine"
import State from "utter/State"
import Transition from "utter/Transition"

import { EVENTS, STATES } from "@/Constants"
import Log from "@/Log"
import GUARDS from "@/StateMachine/Guards"
import REDUCERS from "@/StateMachine/Reducers"



announceWith = (k) => Action((e, mPay, mCtx) => { Log.env.main((k ?? "") ++ e, mPay) })
announce = announceWith(Nothing)
ACTIONS = [announce]
createInitialContext :: Random -> Maybe GameStateContext
export createInitialContext = (random) => Just({
  bets: Dict.empty,
  cardsPerPlayer: -1,
  cardsPerRound: [],
  dealer: Nothing,
  deck: DECK,
  playedCards: [],
  players: [],
  round: -1,
  trick: 0,
  scores: Dict.empty,
  trump: Card(Joker, Wildcard),
  random,
})
gameMachine :: Machine GamePayload GameStateContext
export gameMachine = Machine.create(
  "oh-hell",
  [
    State.create(
      STATES.initial,
      [
        Transition.createComplex(
          EVENTS.playersSet,
          STATES.setPlayers,
          ACTIONS,
          [GUARDS.noPlayers],
          [REDUCERS.setPlayers],
        ),
      ],
    ),
    State.create(
      STATES.setPlayers,
      [
        Transition.createComplex(
          EVENTS.dealerSet,
          STATES.changingDealer,
          ACTIONS,
          [GUARDS.hasNoDealer],
          [REDUCERS.setDealer],
        ),
      ],
    ),
    // I wanna collapse some of these states to something like PREPARING_ROUND
    // but that seems to break things, so I don't wanna go to move to something unstable yet
    State.create(
      STATES.changingDealer,
      [
        Transition.createComplex(
          EVENTS.trumpCardSet,
          STATES.flipTrumpCard,
          ACTIONS,
          [GUARDS.hasNoTrumpCard],
          [REDUCERS.setTrump],
        ),
      ],
    ),
    State.create(
      STATES.flipTrumpCard,
      [
        Transition.createComplex(
          EVENTS.deal,
          STATES.dealing,
          ACTIONS,
          [GUARDS.noCardsDealt],
          [REDUCERS.dealCards],
        ),
      ],
    ),
    State.create(
      STATES.dealing,
      [
        // self transition
        Transition.createComplex(
          EVENTS.bet,
          STATES.dealing,
          ACTIONS,
          [GUARDS.betsIncomplete],
          [REDUCERS.takeBet],
        ),
        // transition away
        Transition.createComplex(
          EVENTS.betsTaken,
          STATES.playing,
          ACTIONS,
          [GUARDS.allBetsTaken],
          [],
        ),
      ],
    ),
    State.create(
      STATES.playing,
      [
        Transition.createComplex(
          EVENTS.trickComplete,
          STATES.playing,
          ACTIONS,
          [GUARDS.roundUnderTotalRound],
          [],
        ),
        Transition.createComplex(
          EVENTS.roundsComplete,
          STATES.scoring,
          ACTIONS,
          [GUARDS.allRoundsComplete],
          [],
        ),
      ],
    ),
    State.createFinal(STATES.failure),
    State.createFinal(STATES.scoring),
  ],
)
