import type { Card } from "gambit/Cards"

import type { Player, Puppeteer } from "@/Player"

import Float from "Float"
import Math from "Math"
import { Just } from "Maybe"

import Cards from "gambit/Cards"

import { EVENTS } from "@/Constants"
import _Player from "@/Player"



naiveBet :: Card -> Integer -> Integer -> Player -> Integer
export naiveBet = (trump, max, totalPlayers, p) => {
  x = _Player.bestCardInHand(Cards.suit(trump), p) ?? Cards.Card(Cards.Joker, Cards.Wildcard)
  median = Math.floor(max / totalPlayers)
  ordRank = pipe(
    Cards.rank,
    Cards.toOrdinal,
  )
  rankT = ordRank(trump)
  rankX = ordRank(x)
  distance = Math.abs(rankX - rankT)
  return if (distance < 3) {
    Float.toInteger(median + 2)
  } else {
    0
  }
}
naiveController :: Puppeteer
export naiveController = (ev, player) => {
  // if (ev == EVENTS.betsTaken) do {
  //   naiveBet( 
  // }
  return player
}
export mindControl = (ev, bot) => where(bot) {
  _Player.Bot(pl, ctrl) =>
    _Player.Bot(ctrl(ev, pl), ctrl)

  _ =>
    bot
}
export create = _Player.Bot($, naiveController)
