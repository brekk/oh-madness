import type { Maybe } from "Maybe"

import type { Card, Suit } from "gambit"

import type { PlayedCard, Player, Puppeteer } from "@/Game"

import Float from "Float"
import Fn from "Function"
import List from "List"
import Math from "Math"
import { Just, Nothing } from "Maybe"

import { Card } from "gambit/Cards"
import Cards from "gambit/Cards"
import Deck from "gambit/Deck"

import { EVENTS } from "@/Constants"
import { Bot, PlayedCard, Player } from "@/Game"
import Log from "@/Log"



name :: Player -> String
export name = where {
  Player(x, _) =>
    x

  Bot(p, _) =>
    name(p)
}
isNamed :: String -> Player -> Boolean
export isNamed = (n, p) => name(p) == n
samePlayer :: Player -> Player -> Boolean
export samePlayer = (a, b) => pipe(
  name,
  isNamed($, a),
)(b)
hand :: Player -> List Card
export hand = where {
  Player(_, cards) =>
    cards

  Bot(p, _) =>
    hand(p)
}
setHand :: List Card -> Player -> Player
export setHand = (h, p) => where(p) {
  Player(n, _) =>
    Player(n, h)

  Bot(Player(n, _), ctrl) =>
    Bot(Player(n, h), ctrl)

  _ =>
    p
}
hasCard :: Card -> Player -> Boolean
export hasCard = (card, pl) => pipe(
  hand,
  Deck.has(card),
)(pl)
discard :: Card -> Player -> Player
export discard = (card, pl) => where(pl) {
  Player(n, cards) =>
    Player(n, Deck.remove(card, cards))

  Bot(p, x) =>
    Bot(discard(card, p), x)
}
// these aren't yet dealing with many of the edge cases:
// you must follow suit if possible
bestCardInHand :: Suit -> Player -> Maybe Card
export bestCardInHand = (trump, p) => pipe(
  hand,
  Deck.sortWithTrump(trump),
  List.first,
)(p)
worstCardInHand :: Suit -> Player -> Maybe Card
export worstCardInHand = (trump, p) => pipe(
  hand,
  Deck.sortLowWithTrump(trump),
  List.first,
)(p)
isBot :: Player -> Boolean
export isBot = where {
  Bot(_, _) =>
    true

  _ =>
    false
}
isHuman :: Player -> Boolean
export isHuman = Fn.complement(isBot)
humanMap :: (Player -> Player) -> Player -> Player
export humanMap = Fn.when(isHuman)
botMap :: (Player -> Player) -> Player -> Player
export botMap = Fn.when(isBot)
export actor = where {
  Bot(_, act) =>
    Just(act)

  _ =>
    Nothing
}
excludingPlayers :: List Player -> List Player -> List Player
export excludingPlayers = (as, bs) => List.reduce(
  (agg, x) => pipe(
    List.reject(samePlayer($, x)),
  )(agg),
  bs,
  as,
)
// :::::::::::::::: BOT LIFE ::::::::::::::::::::


naiveBet :: Card -> Integer -> Integer -> Player -> Integer
export naiveBet = (trump, max, totalPlayers, p) => {
  x = bestCardInHand(Cards.suit(trump), p) ?? Cards.Card(Cards.Joker, Cards.Wildcard)
  median = Math.floor(max / totalPlayers)
  ordRank = pipe(
    Cards.rank,
    Cards.toOrdinal,
  )
  rankT = ordRank(trump)
  rankX = ordRank(x)
  distance = Math.abs(rankX - rankT)
  return if (distance < 3) {
    Float.toInteger(median + 2)
  } else {
    0
  }
}
// export takeBet = (ev, pay, ctx, pl) => {}
naiveController :: Puppeteer
export naiveController = (ev, pay, { trump, cardsPerRound, round, players }, pl) => where(pl) {
  Player(n, h) =>
    Log
      .env
      .player(
        "EVENTED (" ++ ev ++ ")",
        if (ev == EVENTS.betsTaken) do {
          bet = naiveBet(
            trump,
            List.nth(round, cardsPerRound) ?? List.length(players),
            List.length(players),
            pl,
          )
          Log.env.player("<><>", bet)
          return pl
        } else {
          pl
        },
      )

  _ =>
    pl
}
export mindControl = (ev, pay, ctx, botlike) => where(botlike) {
  Bot(pl, ctrl) =>
    Log.env.player("controllllllll", Bot(ctrl(ev, pay, ctx, pl), ctrl))

  _ =>
    botlike
}
export createBot = Bot($, naiveController)
export create = Player
playCard :: Card -> Player -> Maybe PlayedCard
export playCard = (crd, ply) => hasCard(crd, ply) ? Just(PlayedCard(name(ply), crd)) : Nothing
cardPlayedBy :: String -> PlayedCard -> Boolean
export cardPlayedBy = (playerName, pCard) => where(pCard) {
  PlayedCard(by, _) =>
    by == playerName
}
rawCard :: PlayedCard -> Card
export rawCard = where {
  PlayedCard(_, c) =>
    c
}
player :: PlayedCard -> String
export player = where {
  PlayedCard(n, _) =>
    n
}
