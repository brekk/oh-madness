import type { Maybe } from "Maybe"

import type { Card, Suit } from "gambit"
import type { Controller } from "utter/Interpreter"

import Dict from "Dictionary"
import { Left, Right } from "Either"
import Fn from "Function"
import List from "List"
import Math from "Math"
import { Just, Nothing } from "Maybe"
import Random from "Random"

import { ActionReducer } from "utter/Reducer"

import GG from "@/Game"
import Log from "@/Log"
import OhHell from "@/OhHell"
import Player from "@/Player"



alias RedFun pay ctx = String -> pay -> Maybe ctx -> Maybe ctx
_setPlayers :: RedFun pay ctx
_setPlayers = (ev, mPay, mCtx) => where(#[mPay, mCtx]) {
  #[GG.GameSetPlayers(players), Just(ctx)] =>
    pipe(
      Log.tapped.reducer("setting players", .players),
      Just,
    )({ ...ctx, players })

  _ =>
    mCtx
}
export setPlayers = ActionReducer(_setPlayers)
// _setTrump :: RedFun pay ctx
_setTrump = (ev, pay, mCtx) => where(#[pay, mCtx]) {
  #[GG.GameSetTrump, Just(ctx)] =>
    where(Random.shuffle(ctx.deck, ctx.random)) {
      [trump, ...deck] =>
        do {
          Log.env.reducer("trump card", trump)
          return Just({ ...ctx, trump, deck })
        }

      [] =>
        mCtx
    }

  _ =>
    mCtx
}
export setTrump = ActionReducer(_setTrump)
_setDealer :: RedFun pay ctx
_setDealer = (ev, pay, mCtx) => {
  return where(#[pay, mCtx]) {
    #[GG.GameSetDealer, Just(ctx)] =>
      Just({ ...ctx, dealer: Random.pick(ctx.players, ctx.random) })

    _ =>
      mCtx
  }
}
export setDealer = ActionReducer(_setDealer)
_dealCards :: (Show pay, Show ctx) => RedFun pay ctx
_dealCards = (ev, pay, mCtx) => {
  // Log.env.reducer("EVE " ++ ev, #[pay, mCtx])
  return where(#[pay, mCtx]) {
    #[GG.GameDealCards, Just(ctx)] =>
      pipe(
        OhHell.initialDeal,
        where {
          Right(raw) =>
            Just(raw)

          Left(e) =>
            do {
              Log.env.reducer("error", e)
              return mCtx
            }
        },
      )(ctx)

    _ =>
      mCtx
  }
}
export dealCards = ActionReducer(_dealCards)
_takeBet :: (Show pay, Show ctx) => RedFun pay ctx
_takeBet = (ev, pay, mCtx) => {
  return where(#[pay, mCtx]) {
    #[GG.GameTakeBet(pl, bet), Just(ctx)] =>
      do {
        Log.env.player("bet!", #[pl, bet])
        { players, bets } = ctx
        // do we have a bet for every player?
        playersWhoStillNeedToBet = pipe(
          Dict.keys,
          Player.excludingPlayers($, players),
        )(bets)
        botsToBet = List.reject(Player.isHuman, playersWhoStillNeedToBet)
        // I think we wanna move this to an event call slightly downstream from this,
        // as it requires no human intervention
        pipe(
          map(Player.mindControl(ev, pay, ctx)),
          Log.env.reducer("yoyyoyo"),
        )(botsToBet)
        // pipe(
        //   map(Log.env.reducer("dealin")),
        // )(remainder)
        // for every non bot player, we need bets
        return Just(ctx)
      }

    _ =>
      mCtx
  }
}
export takeBet = ActionReducer(_takeBet)
