import type { Maybe } from "Maybe"

import type { Guard, GuardianFn } from "utter/Guard"

import Dict from "Dictionary"
import List from "List"
import { Just, Nothing, isJust } from "Maybe"

import Cards from "gambit/Cards"
import { Guard, complement, invert } from "utter/Guard"

import { EVENTS } from "@/Constants"
import Log from "@/Log"
import Player from "@/Player"



PLACEHOLDER = (_, _, _) => true
GUARDHOLDER = Guard(PLACEHOLDER)
_roundUnderTotalRound :: GuardianFn pay ctx
export _roundUnderTotalRound = (ev, mPay, mCtx) => where(mCtx) {
  Just(ctx) =>
    do {
      // ctx.round + 1 < 
      return false
    }

  _ =>
    false
}
export roundUnderTotalRound = Guard(_roundUnderTotalRound)
_allRoundsComplete :: GuardianFn pay ctx
export _allRoundsComplete = (ev, mPay, mCtx) => where(mCtx) {
  Just(ctx) =>
    do {
      // ctx.round + 1 < 
      return false
    }

  _ =>
    false
}
export allRoundsComplete = Guard(_allRoundsComplete)
_ensurePlayers :: GuardianFn pay ctx
_ensurePlayers = (_, _, mCtx) => Log
  .env
  .guard(
    "ensuring players",
    where(mCtx) {
      Just({ players }) =>
        List.length(players) > 0

      _ =>
        false
    },
  )
export ensurePlayers = Guard(_ensurePlayers)
export noPlayers = Guard(complement(_ensurePlayers))
_hasDealer :: Show ctx => GuardianFn pay ctx
_hasDealer = (_, _, mCtx) => pipe(
  where {
    Just({ dealer }) =>
      isJust(dealer)

    _ =>
      false
  },
)(mCtx)
export hasNoDealer = Guard(complement(_hasDealer))
export hasDealer = Guard(_hasDealer)
_hasTrumpCard :: Show ctx => GuardianFn pay ctx
_hasTrumpCard = (_, _, mCtx) => pipe(
  where {
    Just({ trump }) =>
      !pipe(
        Cards.isNonStandardRank,
      )(trump)

    _ =>
      false
  },
)(mCtx)
export hasTrumpCard = Guard(_hasTrumpCard)
export hasNoTrumpCard = invert(hasTrumpCard)
_cardsDealt = (_, _, mCtx) => where(mCtx) {
  Just({ players }) =>
    List.any(
      pipe(
        Player.hand,
        List.length,
        (x) => x > 0,
      ),
      players,
    )

  _ =>
    false
}
export cardsDealt = Guard(_cardsDealt)
export noCardsDealt = Guard(complement(_cardsDealt))
_betsIncomplete = (_, _, mCtx) => where(mCtx) {
  Just({ bets, players }) =>
    Dict.length(bets) < List.length(players)

  _ =>
    false
}
export betsIncomplete = Guard(_betsIncomplete)
_allBetsTaken = (_, _, mCtx) => where(mCtx) {
  Just({ bets, players }) =>
    Dict.length(bets) == List.length(players)

  _ =>
    false
}
export allBetsTaken = Guard(_allBetsTaken)
export roundIncomplete = GUARDHOLDER
export roundComplete = GUARDHOLDER
