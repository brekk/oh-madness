import type { Maybe } from "Maybe"
import type { Random } from "Random"

import type { Card } from "gambit"
import type { Controller } from "utter/Interpreter"

import Interpreter from "utter/Interpreter"

import { EVENTS } from "@/Constants"
import Log from "@/Log"



export type GamePayload
  = GameSetPlayers(List Player)
  | GameSetDealer
  | GameDealCards
  | GameSetTrump
  | GameReadyToBet
  | GameTakeBet(Player, Integer)
  | GamePlayHand(Maybe (List PlayedCard))
  | GameRecordTrick(Maybe (List PlayedCard))
  | GameRecordRound
export alias GameStateContext = {
  bets :: Dictionary Player Integer,
  cardsPerPlayer :: Integer,
  cardsPerRound :: List Integer,
  dealer :: Maybe Player,
  deck :: List Card,
  playedCards :: List PlayedCard,
  players :: List Player,
  random :: Random,
  round :: Integer,
  scores :: Dictionary Player Integer,
  trick :: Integer,
  trump :: Card,
}
export alias OhHell = Controller GamePayload GameStateContext
export alias GameApi = OhHell -> OhHell
export alias Event = String
export type Player
  = Player(String, List Card)
  | Bot(Player, Event -> GamePayload -> GameStateContext -> Player -> Player)
derive Comparable Player
// convenient to not wrap GameStateContext with Maybe?
export alias Puppeteer = Event -> GamePayload -> GameStateContext -> Player -> Player
// Keep track of who played what card
export type PlayedCard = PlayedCard(String, Card)
