import type { Maybe } from "Maybe"
import type { Random } from "Random"

import type { Card } from "gambit"
import type { Controller } from "utter/Interpreter"

import type { PlayedCard, Player } from "@/Player"

import Interpreter from "utter/Interpreter"

import { EVENTS } from "@/Constants"



/*
// ostensibly we can do more to make this wired to a control flow with direct payloads
// but since a lot of this is going to be randomized, let's use that in lieu of events
// with direct payloads for everything that we can do without players for now
export type GamePayload
  = GameSetPlayers(List Player)
  | GameSetDealer(Player)
  | GameDealCards
  | GameSetTrump(Card)
  | GameTakeBets(Dictionary Player Integer)
  | GameRecordTrick(List PlayedCard)
  | GameRecordRound
*/

// the values which have arguments are tied to ostensible user input
// or are required for any state to proceed

export type GamePayload
  = GameSetPlayers(List Player)
  | GameSetDealer
  | GameDealCards
  | GameSetTrump
  | GameTakeBets(Maybe (Dictionary Player Integer))
  | GamePlayHand(Maybe (List PlayedCard))
  | GameRecordTrick(Maybe (List PlayedCard))
  | GameRecordRound
export alias GameStateContext = {
  bets :: Dictionary Player Integer,
  cardsPerPlayer :: Integer,
  cardsPerRound :: List Integer,
  dealer :: Maybe Player,
  deck :: List Card,
  playedCards :: List PlayedCard,
  players :: List Player,
  random :: Random,
  round :: Integer,
  scores :: Dictionary Player Integer,
  trick :: Integer,
  trump :: Card,
}
export alias OhHell = Controller GamePayload GameStateContext
setPlayers :: List Player -> OhHell -> OhHell
export setPlayers = (players, sv) => Interpreter.send(
  EVENTS.playersSet,
  GameSetPlayers(players),
  sv,
)
setDealer :: OhHell -> OhHell
export setDealer = Interpreter.send(EVENTS.dealerSet, GameSetDealer)
setTrump :: OhHell -> OhHell
export setTrump = Interpreter.send(EVENTS.trumpCardSet, GameSetTrump)
dealCards :: OhHell -> OhHell
export dealCards = Interpreter.send(EVENTS.cardsDealt, GameDealCards)
takeBets :: Maybe (Dictionary Player Integer) -> OhHell -> OhHell
export takeBets = (dict, sv) => Interpreter.send(EVENTS.betsTaken, GameTakeBets(dict), sv)
